# Copier ce fichier en .env.local et renseigner les valeurs réelles.
# Aucune de ces variables n'est encore lue par le code — le projet n'a pas
# encore de backend branché (voir docs/integration-et-specifications-strapi.md).

# --- Strapi (CMS, phase 2 — voir CLAUDE.md section 3) ---
# URL de base de l'instance Strapi, une fois provisionnée.
STRAPI_API_URL=
# Token API en lecture seule (Settings > API Tokens dans Strapi).
STRAPI_API_TOKEN=
# Token dédié au formulaire de contact — permissions limitées à upload +
# contact-submission.create uniquement (voir app/api/contact/route.ts).
STRAPI_CONTACT_API_TOKEN=
# Token dédié à l'inscription newsletter — permissions limitées à
# newsletter-subscriber.create uniquement (voir app/api/newsletter/route.ts).
STRAPI_NEWSLETTER_API_TOKEN=

# --- Envoi d'emails (formulaire de contact + newsletter, voir audit section 1.2) ---
# Fournisseur pas encore choisi (Resend, SMTP, ou autre) — variables à ajouter
# ici une fois la décision prise.
